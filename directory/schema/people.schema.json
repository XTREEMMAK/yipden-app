{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yipden.com/directory/schema/people.schema.json",
  "title": "YipDen directory",
  "description": "Creators listed by YipDen, or a creator list in the same format. Additive: unknown fields are allowed and kept. A reader may add any list in this format.",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "https": { "type": "string", "format": "uri", "pattern": "^https://" },
    "entry": {
      "type": "object",
      "required": ["id", "name"],
      "anyOf": [{ "required": ["site_url"] }, { "required": ["feeds"] }],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,80}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "note": { "type": "string", "maxLength": 500 },
        "site_url": { "$ref": "#/$defs/https" },
        "thumb_url": { "$ref": "#/$defs/https" },
        "thumb_position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "tags": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
        "feeds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "properties": {
              "type": { "type": "string" },
              "url": { "$ref": "#/$defs/https" },
              "verified": { "type": "boolean" }
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "media_url"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "media_url": { "$ref": "#/$defs/https" }
            }
          }
        },
        "listing": { "enum": ["curated", "confirmed"] },
        "discoverable": { "type": "boolean" },
        "identities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(url|bsky|youtube|fedi):\\S+$" }
        },
        "added_at": { "type": "string" }
      }
    }
  }
}
