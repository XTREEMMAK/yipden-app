<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!--
      capacitor-cordova-android-plugins, bundled by Capacitor itself rather than something this
      app chose to add, declares usesCleartextTraffic="true" in its own manifest. Left
      unresolved, that is a hard manifest-merge failure, not a silent default: Gradle refuses to
      guess which value should win. tools:replace below says explicitly that this app's own
      value always does; the actual enforcement is network_security_config.xml, which a plain
      manifest attribute cannot override on its own.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            Portrait on phones and tablets alike (decided 2026-10-05): the layout is a phone column,
            and a tablet held upright at least shows it as designed. Revisit with a tablet layout.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <!--
                Android 16 ignores an orientation lock on large screens for apps targeting API 36.
                This is Google's documented opt-out for that version; it stops applying at API 37,
                by which time tablets need a layout of their own (DECISIONS.md, 2026-10-05).
            -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 14 (API 34) requires this alongside the plain FOREGROUND_SERVICE permission for
      any service declaring foregroundServiceType="mediaPlayback", which is how
      @capgo/capacitor-media-session keeps the lock screen and notification controls alive.
      Its own manifest declares FOREGROUND_SERVICE but not this one, so it is added here.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
        The in-app browser plugin asks for the camera so a page's file picker can take a photo.
        YipDen never needs that from a creator's page, so the merged manifest drops it here,
        whatever a plugin version declares. See docs/security.md.
    -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
</manifest>
