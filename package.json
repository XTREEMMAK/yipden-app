{
  "name": "yipden",
  "version": "0.9.0",
  "description": "YipDen: a mobile reader for the indie web. Follow people, not platforms.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "games:dev": "pnpm --filter @yipden/games-lab dev",
    "games:dev:references": "YIPDEN_GAME_REFERENCES=1 pnpm --filter @yipden/games-lab dev",
    "games:check": "pnpm --filter @yipden/game-contracts --filter @yipden/game-host --filter @yipden/realm-core --filter @yipden/realm-player --filter @yipden/stray --filter @yipden/games-lab check",
    "games:test": "pnpm --filter @yipden/game-contracts --filter @yipden/game-host --filter @yipden/realm-core test",
    "games:verify": "node tooling/games/verify.mjs",
    "games:apk": "pnpm --filter @yipden/games-lab android:apk",
    "games:publish": "pnpm --filter @yipden/games-lab android:publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
